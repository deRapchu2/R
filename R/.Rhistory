crazy <- function(x , y = 10 , ...){ #... ellipses used for wrappers or extra arguments
#x and y here are local variables
x^y
if (x > 4){
stop("Cant do this ")
}
}
crazy(5)
crazy <- function(x , y = 10 , ...){ #... ellipses used for wrappers or extra arguments
#x and y here are local variables
x^y
if (x > 10){
stop("Cant do this ")
}else if(x >4){
warning("Too much")
}
}
crazy(4)
crazy(4)
crazy <- function(x , y = 10 , ...){ #... ellipses used for wrappers or extra arguments
#x and y here are local variables
x^y
if (x > 10){
stop("Cant do this ")
}else if(x >4){
warning("Too much")
return(x^y)
}
}
crazy(4)
crazy(3)
crazy <- function(x , y = 10 , ...){ #... ellipses used for wrappers or extra arguments
#x and y here are local variables
return(x^y)
