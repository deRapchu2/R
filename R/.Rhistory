crazy <- function(x, y = 10, ...) {
if (x > 10) {
stop("Cant do this")
} else if (x > 4) {
warning("Too much")
return(x^y)
} else {
return(x^y)
}
}
crazy(x =11)
crazy(6)
crazy(3)
y<-crazy(3)
